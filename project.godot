; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DSCR Asterclient"
config/version="0.4.1"
config/tags=PackedStringArray("2d", "effort", "ui")
run/main_scene="uid://bft3wuvruhqvw"
config/auto_accept_quit=false
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.07058824, 0, 0.10980392, 1)
boot_splash/stretch_mode=0
boot_splash/image="uid://j24vprtvfml2"
config/icon="res://icon.svg"

[display]

window/size/mode=2
window/size/initial_position_type=5
window/size/sharp_corners=true
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://Assets/": "yellow",
"res://Assets/Sounds/": "orange",
"res://Builds/": "orange",
"res://Scenes/": "green",
"res://Scenes/CallsignPicker/": "gray",
