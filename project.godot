; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DSCR Asterclient"
config/version="build_3"
config/tags=PackedStringArray("2d", "effort", "ui")
run/main_scene="uid://bft3wuvruhqvw"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/mode=2
window/size/initial_position_type=5
window/size/sharp_corners=true
window/stretch/aspect="expand"

[file_customization]

folder_colors={
"res://Builds/": "orange",
"res://Scenes/": "green",
"res://Scenes/CallsignPicker/": "gray",
"res://Scenes/ChatMenu/": "blue",
"res://Scenes/Common/": "gray",
"res://Scenes/DictDisplayMenu/": "orange",
"res://Scenes/DictEditMenu/": "yellow",
"res://Scenes/Images/": "red",
"res://Scenes/OnlineUsersTab/": "pink",
"res://Scenes/SettingsMenu/": "orange",
"res://Scripts/": "gray",
"res://Styling/": "purple",
"res://fonts/": "red"
}

