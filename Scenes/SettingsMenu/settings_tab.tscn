[node name="todo" type="RichTextLabel" parent="ScrollContainer/MarginContainer/Options" unique_id=1987941446]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
text = "the todo list will be removed at some point
TODO:
- add transmission editor and library window
- change placement of copy button (find a visible spot that doesn't cause formatting to screw up when it appears/disappears)
- lone confetti signal makes confetti setting (configurable \"confetti\" signal)
- add \"macro-dictionary\" sidebar
- make sidebar collapsable
- make callsign picker collapsable
- add more formatting options: indent all proceeding, dedent here and all proceeding, prior attract, next attract (attract removes space), auto-group-with-other-signal
- setting for received COLOR # to display that color, somewhere
- figure out what to do if a transmission is not received (ie a number is skipped)
- entering signals into notes so that they auto-update
- make pressing MAKES ELSE SENSE create the dictionary entry instead of only bringing up the menu, or else make that a setting
- hover over translated words to get the signal
- hover over negative numbers to get the translation
- implement message history so you can use arrow keys to access your previous transmissions
- drag and drop dictionary
- change save directory setting?
- optimize (old transmissions queue free but are saved as a string. scrolling up will load old stuff and unload new stuff)
nikzapp todo:
- confetti
- arbitrary parsing
- lua modules
- android support"
fit_content = true
scroll_active = false
shortcut_keys_enabled = false
meta_underlined = false
hint_underlined = false

